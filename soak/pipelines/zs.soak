name: Thematic analysis
default_context:
  persona: Experienced qual researcher
  research_question: To understand the experience of participants
  specific_research_question: ""
scrub: false
randomise_document_order: true
config:
    report_texts: [narrative, meta_narrative]
default_config:
  model_name: gpt-4.1-mini
  seed: 1

  
nodes:
  - name: chunks
    type: Split
    split_unit: words
    chunk_size: 15000
    min_split: 500
    overlap: 200
    inputs:
      - documents
      
  - name: codes_from_chunks
    type: Map
    template: initial_codes.sd
    inputs:
      - chunks

  - name: groupedcodes
    type: Cluster
    inputs: [codes_from_chunks]
    items_field: codes      # extract Code objects from CodeList.codes
    method:
      name: hdbscan
      min_cluster_size: 2
      max_cluster_size: 120
      
  - name: consolidated_codes
    type: Map
    inputs: [groupedcodes]
    template: consolidate_codes.sd

  - name: codes
    type: Reduce
    items_field: codes
    inputs: [consolidated_codes]
  
  - name: checkquotes
    type: VerifyQuotes
    model_name: gpt-4.1-mini
    inputs: [codes]
    check_fairness: false
    
  - name: big_code_groups
    type: Cluster
    inputs: [codes]
    items_field: codes
    method:
      name: hdbscan
      min_cluster_size: 50
      
  - name: theme_groups
    type: Map
    template: make_theme_group.sd
    inputs:
      - big_code_groups

  - name: flat_themes
    type: Reduce
    items_field: themes
    inputs:
      - theme_groups
    
  - name: themes
    type: Transform
    template: final_themes.sd
    inputs:
      - theme_groups

  - name: narrative
    type: Transform
    model_name: gpt-4.1
    template: narrative_report.sd
    temperature: 1.0
    inputs:
      - themes
    
  - name: meta_narrative
    type: Transform
    model_name: gpt-4.1
    template: meta_narrative.sd
    inputs:
      - themes
      - narrative
    

    
