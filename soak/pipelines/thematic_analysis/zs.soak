name: Thematic analysis
version: 0.1.0
description: A qualitative thematic analysis of transcript data, based on reflexive thematic analysis. Codes are generated independently for each document, and then clustered and combined before being used to generate themes.
default_context:
  research_question:
    type: primary
    default: To understand the experience of participants
    description: Research question
    help_text: The main question guiding the thematic analysis
  persona:
    type: secondary
    default: Experienced qualitative researcher, expert in reflexive thematic analysis.
    description: Analyst persona
    help_text: The perspective and expertise from which the analysis is conducted.
  report_audience:
    type: secondary
    default: other researchers
    description: Report audience
    help_text: Who will be reading the report. This is the intended audience, not the researcher. 
    
  additional_instructions_main_report:
    type: secondary
    default: null
    description: Additional instructions for the main report
    help_text: This text is presented when writing the final report. You can direct the writing for a particular audience or purpose.
  
  additional_instructions_meta_report:
    type: secondary
    default: null
    description: Additional instructions for the summary/overview report
    help_text: This text is presented when writing the summary/overview report. You can direct the writing for a particular audience or purpose.  
  
  epistemological_stance:
    type: secondary
    default: This analysis takes a pragmatic, reflexive approach to thematic analysis. We treat participants’ accounts as meaningful representations of their experiences, while recognising that these accounts are shaped by context, language, and the research process itself. Themes are therefore not treated as purely emergent from the data, but as constructed through an interaction between the data, the research question, and analytic judgement. The analysis prioritises usefulness and explanatory power in relation to the research question, rather than claiming to uncover objective or universal truths. We focus on patterns of meaning and shared processes across participants, while remaining attentive to nuance, contradiction, and variation in how experiences are expressed and interpreted.
    description: Epistemological stance
    help_text: This text is presented during all key steps (coding, theme generation, report writing). You can give extra instructions on how to write themes, or what to look out for when generating them.
    
  specific_research_question:
    type: secondary
    default: ""
    description: Specific research focus
    help_text: (Optional) specific aspect or sub-question to focus on. This text is not included in the prompt that generates codes, so can be varied post-coding.
    input_type: textarea
  specific_coding_guidance:
    type: secondary
    default: null
    description: Specific coding guidance 
    help_text: You can give extra instructions on what types of codes to extract, or how to interpret the source texts during the initial coding step.
    input_type: textarea
  additional_theme_guidance:
    type: secondary
    default: null
    description: Additional theme guidance.
    help_text: This text is presented during theme generation prompts. You can give extra instructions on how to write themes, or what to look out for when generating them.
    input_type: textarea
  input_data_format:
    type: config
    default: The data consist of transcripts from interviews/focus groups, and/or answers to open-ended questions in surveys.
    description: Describe your specific input data.
    help_text: Describing the input data helps soak understand how to interpret it.
    input_type: textarea
  theme_size_guidance:
    type: config
    default: "Produce 7-10 themes. Strongly prefer fewer/larger themes with greater explanatory depth and power. Combine overlapping themes, creating a richer, more nuanced analysis."
    description: Guidance on the number of themes to produce.
    help_text: ""
    input_type: textarea
  max_themes:
    type: config
    default: 12
    description: Maximum number of themes to generate
    help_text: Maximum number of themes to generate (hard cap)
  min_themes:
    type: config
    default: 3
    description: Minimum number of themes to generate
    help_text: Minimum number of themes to generate (hard cap)
  
scrub: false
randomise_document_order: true

allow_web_overrides:
  chunks:
    - chunk_size:
        label: Chunk size (in words)
    - min_split:
        label: Minimum size for a chunk make from splitting documents
    - overlap:
        label: Overlap between chunks
  codes_from_chunks:
    - thinking:
        label: Level of thinking for the initial code generation
  groupedcodes:
    - skip_below:
        label: Skip clustering step if we have fewer than this many codes
  checkquotes:
    - check_fairness:
        label: Check fairness
        help_text: Checks quotes for fairness using an extra LLM call for each quote found with a low confidence score. This is slower but more accurate.
  theme_groups:
    - thinking:
        label: Level of thinking for the first-stage theme generation
  themes:
    - thinking:
        label: Level of thinking for the final theme generation
  narrative:
    - thinking:
        label: Level of thinking for the narrative report generation
    - temperature:
        label: Temperature
        help_text: Controls the randomness of the narrative generation. Higher temperatures make the narrative more random, while lower temperatures make it more focused and deterministic. Best results between 0.7 and 1.2.
config:
    report_texts: 
      narrative.meta_narrative:
        label: Summary
        description: Overarching narrative account of the analysis.
      narrative.narrative:
        label: Thematic Narrative
        description: "Text-representation of all themes identified in the analysis."

default_config:
  models:
    default: gpt-5.4-mini
    best: gpt-5.4-mini
    cheap: gpt-5.4-mini
  embeddings: text-embedding-3-large
  seed: 1

methodology_templates:
  overview: |
      

nodes:
  - name: chunks
    type: Split
    split_unit: words
    chunk_size: 8000
    min_split: 500
    overlap: 100
    inputs:
      - documents
      
  - name: codes_from_chunks
    type: Map
    template: initial_codes.sd
    max_tokens: 4000
    model: default
    thinking: medium
    inputs:
      - chunks

  - name: groupedcodes
    type: Cluster
    inputs: [codes_from_chunks]
    items_field: codes  # extract from ChatterResult containers
    skip_below: 75
    if_skipped_bypass_to: codes  # bypass consolidation of cluster
    method:
      name: hdbscan
      min_cluster_size: 2
      max_cluster_size: 50

  - name: consolidated_codes
    type: Map
    inputs: [groupedcodes]
    model: default
    thinking: low
    template: consolidate_codes.sd
    invariants:
      - code_retention_and_quotes

  - name: codes
    type: Reduce
    items_field: codes
    inputs: [consolidated_codes]

  - name: checkquotes
    type: VerifyQuotes
    model: cheap
    thinking: low
    inputs: [codes]
    check_fairness: false

  - name: big_code_groups
    type: Cluster
    inputs: [codes]
    method:
      name: hdbscan
      min_cluster_size: 50
      
  # produces a list of theme lists, one for each code group
  - name: theme_groups
    type: Map
    template: make_theme_group.sd
    model: best
    thinking: medium
    inputs:
      - big_code_groups

  - name: themes
    type: Transform
    template: final_themes.sd
    model: best
    thinking: medium
    inputs:
      - theme_groups
    invariants:
      - min_themes_with_codes

  - name: narrative
    type: Transform
    template: narrative_report.sd
    temperature: 1.0
    model: best
    thinking: medium
    inputs:
      - themes
