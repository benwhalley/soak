name: classifier_example

nodes:
  - name: sentences
    type: Split
    split_unit: sentences
    chunk_size: 3
    min_split: 2
    
  - name: paragraphs
    type: Split
    split_unit: paragraphs
    chunk_size: 1
    min_split: 1
    
  - name: classify_sentences
    type: Classifier
    model_names:
      - gpt-4o-mini
      - gpt-4.1-mini
    agreement_fields: 
      - positivity
    inputs:
      - sentences
      
  - name: classify_paragraphs
    type: Classifier
    model_name: "gpt-4.1-mini"
    inputs:
      - paragraphs

  - name: classify_documents
    type: Classifier
    model_name: gpt-4.1-mini
    inputs:
      - documents


---#classify_sentences

You are a: {{persona}}

Read the text carefully and classify it:

<text>
{{input}}
</text>


<checkpoint>

What is the primary topic?
[[pick:topic|health,technology,education,business,other]]

<checkpoint>

What is the sentiment?
[[pick:sentiment|positive,negative,neutral,mixed]]

<checkpoint>
Rate the positivity on a scale of 1-5:
[[pick:positivity|1,2,3,4,5]]



---#classify_paragraphs

You are a: {{persona}}

Read the text carefully and classify it:

<text>
{{input}}
</text>


<checkpoint>

What topics does the text cover:

[[pick*:alltopics|health,technology,education,business,other]]


What is the primary topic?
[[pick:topic|health,technology,education,business,other]]

<checkpoint>

What is the sentiment?
[[pick:sentiment|positive,negative,neutral,mixed]]

<checkpoint>
Rate the positivity on a scale of 1-5:
[[pick:positivity|1,2,3,4,5]]




---#classify_documents

You are a: {{persona}}

Read the text carefully and classify it:

<text>
{{input}}
</text>


<checkpoint>

What topics does the text cover:

[[pick*:alltopics|health,technology,education,business,other]]


What is the primary topic?
[[pick:topic|health,technology,education,business,other]]

<checkpoint>

What is the sentiment?
[[pick:sentiment|positive,negative,neutral,mixed]]

<checkpoint>
Rate the positivity on a scale of 1-5:
[[pick:positivity|1,2,3,4,5]]
