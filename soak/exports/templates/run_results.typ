// Run Results Report - Generated by Soak
// This template uses variables injected by the Python exporter

#set document(
  title: "{{ run_name|e }} - Analysis Results",
  author: "Soak v{{ version }}",
)

#set page(
  paper: "a4",
  margin: (x: 2cm, y: 2.5cm),
  header: context {
    if counter(page).get().first() > 1 [
      #text(size: 9pt, fill: gray)[{{ run_name|e }} -- Analysis Results]
      #h(1fr)
      #text(size: 9pt, fill: gray)[Page #counter(page).display()]
    ]
  },
)

#set text(
  font: "Linux Libertine",
  size: 11pt,
)

#set heading(numbering: "1.")

#set par(justify: true)

// Title page
#align(center)[
  #v(3cm)
  #text(size: 24pt, weight: "bold")[Analysis Results]
  #v(0.5cm)
  #text(size: 16pt)[{{ run_name|e }}]
  #v(2cm)

  #table(
    columns: 2,
    stroke: none,
    align: (right, left),
    [*Pipeline:*], [{{ pipeline_name|e }}],
    [*Model:*], [{{ model_name|e }}],
    [*Date:*], [{{ completed_at }}],
    [*Documents:*], [{{ doc_count }} ({{ word_count }} words)],
    {% if duration %}[*Duration:*], [{{ duration }}],{% endif %}
    {% if cost %}[*Cost:*], [\${{ cost }}],{% endif %}
  )

  #v(1cm)
  #line(length: 50%, stroke: 0.5pt + gray)
  #v(0.5cm)
  #box[
    #image("soak-logo.svg", height: 24pt)
    #h(0.5em)
    #link("{{ github_url }}")[#text(size: 10pt, fill: gray)[Soak v{{ version }}]]
  ]
]

#pagebreak()

// Summary
= Summary

This analysis identified *{{ theme_count }} themes* and *{{ code_count }} codes* from {{ doc_count }} source documents.

{% if narrative %}
= Narrative

{{ narrative|md }}
{% endif %}

{% if meta_narrative %}
= Meta-Narrative

{{ meta_narrative|md }}
{% endif %}

// Themes
#pagebreak()
= Themes

{% for theme in themes %}
== {{ theme.name|capitalize|e }}

{{ theme.description|md }}

{% if theme.codes %}
*Related codes:* {{ theme.codes | map('e') | join(", ") }}
{% endif %}

{% if theme.quotes %}
*Sample quotes:*
{% for quote in theme.quotes[:3] %}
#quote(block: true)[{{ quote|e }}]
{% endfor %}
{% endif %}

{% endfor %}

{% if self_similarity and self_similarity.n_themes > 1 %}
// Theme Overlap / Self-Similarity Matrix
#pagebreak()
= Theme Overlap

This matrix shows the semantic similarity between themes. Higher values indicate greater conceptual overlap.

#figure(
  table(
    columns: {{ self_similarity.n_themes + 1 }},
    stroke: 0.5pt + gray,
    align: center,
    // Header row
    [], {% for label in self_similarity.short_labels %}[*{{ label }}*], {% endfor %}
    // Data rows
    {% for i in range(self_similarity.n_themes) %}
    [*{{ self_similarity.short_labels[i] }}*], {% for j in range(self_similarity.n_themes) %}[{% if i == j %}-{% else %}{{ "%.2f"|format(self_similarity.calibrated_matrix[i][j]) }}{% endif %}], {% endfor %}
    {% endfor %}
  ),
  caption: [Theme self-similarity matrix (calibrated scores). {{ self_similarity.short_labels | join(", ") }} correspond to the themes listed above.],
)

#v(1em)
*Legend:*
{% for i, name in enumerate(self_similarity.themes) %}
- *{{ self_similarity.short_labels[i] }}*: {{ name|e }}
{% endfor %}
{% endif %}

// Codes (as appendix)
#pagebreak()
= Appendix: All Codes

{% for code in codes %}
== {{ code.name|capitalize|e }}

{{ code.description|md }}

{% if code.quotes %}
*Supporting quotations ({{ code.quotes | length }}):*

{% for quote in code.quotes[:5] %}
#quote(block: true)[{{ (quote.text if quote.text else quote)|e }}]
{% endfor %}
{% if code.quotes | length > 5 %}
#text(fill: gray)[... and {{ code.quotes | length - 5 }} more quotes]
{% endif %}
{% endif %}

{% endfor %}

// Methods section
#pagebreak()
= Methods

{{ methods_text|md }}

// Configuration
#pagebreak()
= Analysis Configuration

#table(
  columns: 2,
  stroke: (x: none, y: 0.5pt + gray),
  align: (right, left),
  [*Pipeline*], [{{ pipeline_name|e }}],
  [*Model*], [{{ model_name|e }}],
  [*Documents*], [{{ doc_count }}],
  [*Total words*], [{{ word_count }}],
  {% if sample_n %}[*Sample size*], [{{ sample_n }}],{% endif %}
  {% if seed %}[*Random seed*], [{{ seed }}],{% endif %}
  [*Prompt tokens*], [{{ prompt_tokens }}],
  [*Completion tokens*], [{{ completion_tokens }}],
  {% if completion_ratio %}[*Completion ratio*], [{{ completion_ratio }}],{% endif %}
)
