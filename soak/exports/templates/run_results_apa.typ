// APA 7th Edition Style Analysis Report
// Generated by Soak

#set document(
  title: "{{ run_name|e }}",
  author: "Soak v{{ version }}",
)

#set page(
  paper: "us-letter",
  margin: (x: 1in, y: 1in),
  header: context {
    if counter(page).get().first() > 1 [
      #text(size: 12pt, font: "Times New Roman")[
        #upper[{{ run_name|e }}]
        #h(1fr)
        #counter(page).display()
      ]
    ]
  },
)

#set text(
  font: "Times New Roman",
  size: 12pt,
)

#set par(
  justify: false,
  leading: 2em,
  first-line-indent: 0.5in,
)

// APA heading styles (no numbering)
#show heading.where(level: 1): it => {
  set text(size: 12pt, weight: "bold")
  set align(center)
  set par(first-line-indent: 0pt)
  v(1em)
  it.body
  v(0.5em)
}

#show heading.where(level: 2): it => {
  set text(size: 12pt, weight: "bold")
  set align(left)
  set par(first-line-indent: 0pt)
  v(1em)
  it.body
  v(0.5em)
}

#show heading.where(level: 3): it => {
  set text(size: 12pt, weight: "bold", style: "italic")
  set align(left)
  set par(first-line-indent: 0pt)
  v(0.5em)
  it.body
  v(0.25em)
}

// Block quote style (APA)
#let blockquote(body) = {
  set par(first-line-indent: 0pt)
  pad(left: 0.5in)[
    #set text(size: 11pt)
    #body
  ]
}

// Title page
#align(center)[
  #v(2in)
  #text(size: 12pt, weight: "bold")[{{ run_name|e }}]

  #v(1em)
  Generated by Soak v{{ version }}

  #v(1em)
  #text(size: 12pt)[
    {% if completed_at %}{{ completed_at }}{% else %}Analysis Report{% endif %}
  ]
]

