name: test_verify_quotes

nodes:
  - name: chunks
    type: Split
    split_unit: sentences
    chunk_size: 5

  - name: codes
    type: Map
    inputs:
      - chunks

  - name: verify
    type: VerifyQuotes
    inputs:
      - codes

---#chunks
{{input}}

---#codes

