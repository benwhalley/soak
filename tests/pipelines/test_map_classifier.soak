name: test_map_classifier

nodes:
  - name: extract_themes
    type: Map
    inputs:
      - documents

  - name: classify_themes
    type: Classifier
    model_names:
      - gpt-4o-mini
    inputs:
      - extract_themes

---#extract_themes

Extract main themes from this text:

<text>
{{response}}
</text>

Key themes: [[themes:]]

---#classify_themes

Classify the relevance of these themes:

<themes>
{{input}}
</themes>

Relevance: [[pick:relevance|high,medium,low]]
