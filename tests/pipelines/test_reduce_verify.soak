name: test_map_verify

nodes:
  - name: extract_codes
    type: Map
    inputs:
      - documents

  - name: verify
    type: VerifyQuotes
    window_size: 300
    inputs:
      - extract_codes

---#extract_codes

Extract themes with supporting quotes from this text:

<text>
{{input}}
</text>

Only include direct quotes from the text above.

[[code*:codes]]
