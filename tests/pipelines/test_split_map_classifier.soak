name: test_split_map_classifier

nodes:
  - name: chunks
    type: Split
    split_unit: sentences
    chunk_size: 3

  - name: extract
    type: Map
    inputs:
      - chunks

  - name: classify
    type: Classifier
    model_names:
      - gpt-4o-mini
    inputs:
      - extract

---#chunks
{{input}}

---#extract

Extract key points:

<text>
{{input}}
</text>

[[points]]

---#classify

Classify topic:

<text>
{{input}}
</text>

[[pick:topic|business,economics,lifestyle,other]]
