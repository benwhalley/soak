name: test_split_map_reduce

nodes:
  - name: chunks
    type: Split
    split_unit: sentences
    chunk_size: 5

  - name: summarize_chunks
    type: Map
    inputs:
      - chunks

  - name: combine
    type: Reduce
    inputs:
      - summarize_chunks

